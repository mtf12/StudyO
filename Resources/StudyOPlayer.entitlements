<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Needed only because the app is signed locally (no Apple Developer ID): without a team
         identity macOS cannot match the bundled video engine libraries to the app.
         Remove this once the app is signed with a Developer ID certificate. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
